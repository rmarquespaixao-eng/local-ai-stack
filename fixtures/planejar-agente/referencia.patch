+package dev.agente.app.tools;
+
+import dev.agente.core.port.RunScopedTool;
+import java.util.Map;
+import org.springframework.stereotype.Component;
+
+@Component
+public class NotesReadTool implements RunScopedTool {
+    public String name() { return "notes.read"; }
+    public String description() { return "Lê uma nota do run: arg key"; }
+    public String execute(Map<String, String> args) { throw new IllegalStateException("run_scope_required"); }
+    public String execute(Map<String, String> args, Map<String, String> notes) {
+        String key = args.get("key");
+        if (key == null || key.isBlank()) throw new IllegalArgumentException("invalid_args");
