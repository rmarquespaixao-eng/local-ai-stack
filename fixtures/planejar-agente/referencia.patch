+package dev.agente.app.tools;
+
+import dev.agente.core.port.RunScopedTool;
+import java.util.Map;
+import org.springframework.stereotype.Component;
+
+@Component
+public class NotesWriteTool implements RunScopedTool {
+    public String name() { return "notes.write"; }
+    public String description() { return "Grava uma nota do run: args key, value"; }
+    public String execute(Map<String, String> args) { throw new IllegalStateException("run_scope_required"); }
+    public String execute(Map<String, String> args, Map<String, String> notes) {
+        String key = args.get("key");
+        String value = args.get("value");
+        if (key == null || key.isBlank() || value == null) throw new IllegalArgumentException("invalid_args");
+        notes.put(key, value);
+        return "ok";
+    }
+}
